# Server-side Gemini key. Set as a private runtime secret for hosted Rosogolla.
GEMINI_API_KEY=
# Google OAuth web client ID. Add http://localhost:4173 as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=
# Optional model overrides.
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
PORT=4173
