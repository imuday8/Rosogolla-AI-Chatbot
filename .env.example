# Server-side OpenRouter key. Set as a private runtime secret for hosted Rosogolla.
OPENROUTER_API_KEY=
# Google OAuth web client ID. Add http://localhost:4173 as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=
# Optional model override (default: openrouter/free).
OPENROUTER_MODEL=openrouter/free
# Optional voice provider. Leave empty to disable live voice.
VOICE_PROVIDER=
PORT=4173
